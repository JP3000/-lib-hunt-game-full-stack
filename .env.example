# 复制为 .env.local 后按需修改（.env / .env.local 已被 .gitignore 忽略）。
#
# 注意：这个文件只对前端生效（Next.js 会读取 .env.local）。
# 后端（Spring Boot）不读 .env 文件，后端变量需要通过 shell、IDE 运行配置或 systemd 注入：
#   export JWT_SECRET=... && cd server && ./mvnw spring-boot:run
# 下面的「后端」部分仅作变量清单参考。

# ---------- 后端 ----------
# JWT 签名密钥，至少 32 字节。生产环境必须改成随机值。
JWT_SECRET=dev-only-change-me-please-32-bytes-minimum

# 首次启动自动创建的管理员账号（库里已有 ADMIN 时不会重复创建）
ADMIN_STUDENT_NO=admin
ADMIN_INITIAL_PASSWORD=Admin@123456

# 数据库 / Redis：application.yml 里的默认值是本地 docker-compose 的映射端口，
# 需要覆盖时使用 Spring Boot 的环境变量名（下面这些仅作示例）。
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/libhunt?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6380

# ---------- 前端 ----------
# 本地开发时 /api/* 的转发目标（Spring Boot 地址）。
# 生产环境由 Nginx 做同样的反代，通常不需要设置。
API_PROXY_TARGET=http://127.0.0.1:8080
